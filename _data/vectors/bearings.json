    }
  ],
  "operations": [
    {
      "id": "inverse",
      "gives": "The distance and initial bearing between two points",
      "inputs": [
        "fromLatitudeInDegrees",
        "fromLongitudeInDegrees",
        "toLatitudeInDegrees",
        "toLongitudeInDegrees"
      ],
      "outputs": [
        "distanceInMeters",
        "bearingInDegrees"
      ]
    },
    {
      "id": "destination",
      "gives": "The point at a distance and bearing from another",
      "inputs": [
        "fromLatitudeInDegrees",
        "fromLongitudeInDegrees",
        "distanceInMeters",
        "bearingInDegrees"
      ],
      "outputs": [
        "toLatitudeInDegrees",
        "toLongitudeInDegrees"
      ]
    },
    {
      "id": "backAzimuth",
      "gives": "The reverse of a bearing",
      "inputs": [
        "bearingInDegrees"
      ],
      "outputs": [
        "backAzimuthInDegrees"
      ]
    },
    {
      "id": "turn",
      "gives": "The shortest turn from one bearing to another",
      "inputs": [
        "fromBearingInDegrees",
        "toBearingInDegrees"
      ],
      "outputs": [
        "turnInDegrees",
        "direction"
      ]
    },
    {
      "id": "convertNorth",
      "gives": "A bearing converted between true, magnetic and grid north",
      "inputs": [
        "bearingInDegrees",
        "fromNorth",
        "toNorth",
        "magneticDeclinationInDegrees",
        "convergenceInDegrees"
      ],
      "outputs": [
        "convertedBearingInDegrees"
      ]
    },
    {
      "id": "formatBearing",
      "gives": "A bearing written in degrees or mils",
      "inputs": [
        "bearingInDegrees",
        "angleUnit"
      ],
      "outputs": [
        "bearingText"
      ]
    },
    {
      "id": "compassPoint",
      "gives": "The compass point nearest a bearing",
      "inputs": [
        "bearingInDegrees",
        "pointCount",
        "style"
      ],
      "outputs": [
        "compassPointText"
      ]
    }
  ],
  "fields": {
    "fromLatitudeInDegrees": "The start, −90 to 90",
    "fromLongitudeInDegrees": "The start, −180 to 180",
    "toLatitudeInDegrees": "The end, −90 to 90",
    "toLongitudeInDegrees": "The end, −180 to 180",
    "distanceInMeters": "Along the great circle",
    "bearingInDegrees": "0 to 360, clockwise from north",
    "backAzimuthInDegrees": "The bearing plus 180°, in 0 to 360",
    "fromBearingInDegrees": "The heading now",
    "toBearingInDegrees": "The heading wanted",
    "turnInDegrees": "0 to 180",
    "direction": "left or right",
    "fromNorth": "true, magnetic or grid",
    "toNorth": "true, magnetic or grid",
    "magneticDeclinationInDegrees": "True to magnetic, east positive, from the magnetic model",
    "convergenceInDegrees": "True to grid, east positive, from UTM",
    "convertedBearingInDegrees": "0 to 360",
    "angleUnit": "degrees, natoMils (6400), warsawPactMils (6000) or swedishMils (6300)",
